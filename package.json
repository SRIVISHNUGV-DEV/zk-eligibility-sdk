{
  "name": "zk-eligibility-sdk",
  "version": "1.0.0-beta.1",
  "description": "Cryptographically proven eligibility proofs for Web3. Zero-knowledge, privacy-preserving, sybil-resistant.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-APACHE2.0",
    "LICENSE-MIT",
    "README.md",
    "RULES.md",
    "SECURITY.md"
  ],
  "scripts": {
  "build": "tsc && npm run copy:assets",
  "copy:assets": "powershell -Command \"Copy-Item -Recurse -Force src\\circuits dist\\circuits\"",
  "test": "jest",
  "test:all": "ts-node test-all-rules.ts",
  "test:e2e": "ts-node e2e.ts",
  "dev": "ts-node src/index.ts",
  "cli": "ts-node cli/index.ts",
  "prove": "ts-node cli/index.ts prove",
  "verify": "ts-node cli/index.ts verify",
  "prepublishOnly": "npm run build && npm run test:all"
},
  "bin": {
    "zk-eligibility": "dist/cli/index.js"
  },
  "keywords": [
    "zero-knowledge",
    "zk-proofs",
    "zk-snark",
    "groth16",
    "eligibility",
    "blockchain",
    "ethereum",
    "circom",
    "privacy",
    "sybil-resistance",
    "airdrop",
    "dao",
    "defi"
  ],
  "author": "Srivishnu G V",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/srivishnu-gv/zk-eligibility-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/srivishnu-gv/zk-eligibility-sdk/issues"
  },
  "homepage": "https://github.com/srivishnu-gv/zk-eligibility-sdk#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "circomlib": "^2.0.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.16.0",
    "ffjavascript": "^0.2.60",
    "snarkjs": "^0.7.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  },
  "exports": {
  ".": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  }
}
}